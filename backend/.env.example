# Copy this file to .env and fill in real values before running the server.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True

# Comma-separated hosts allowed to serve the API (add your domain in production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from the browser
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
